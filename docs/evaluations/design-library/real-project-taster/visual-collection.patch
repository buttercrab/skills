 .absorb summary::before { content: '+'; width: 1.25em; }
 .absorb[open] summary::before { content: '\2212'; }
 .absorb .lookbar-row { margin-top: var(--sp-1); }
+
+/* Visual browsing leads; brand controls and collection management open on demand. */
+.gallery-look { margin-bottom: var(--sp-4); }
+.gallery-look > summary, .tray-picks > summary { min-height: 44px; padding: var(--sp-2) 0; cursor: pointer; color: var(--text-muted); }
+.gallery-look[open] > summary { margin-bottom: var(--sp-2); }
+.collection-views { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-4); }
+.tray-picks { flex-basis: 100%; min-width: 0; }
+.tray-picks ul { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; margin: var(--sp-2) 0 0; padding: 0; }
+.tray-picks li { min-width: 0; max-width: 100%; }
+.picked-item { display: flex; align-items: center; gap: var(--sp-2); max-width: 100%; min-height: 44px; padding: var(--sp-1) var(--sp-2); border: 1px solid var(--border); border-radius: var(--r-md); background: var(--bg); color: var(--text); font: inherit; cursor: pointer; text-align: left; }
+.picked-item img { flex: none; width: 64px; height: 40px; object-fit: cover; border-radius: var(--r-sm); }
+.picked-item span { min-width: 0; overflow-wrap: anywhere; }
